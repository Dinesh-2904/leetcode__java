class Solution {
    public int characterReplacement(String s, int k) {
        int[] freq = new int [26];
        int left = 0;
        int max = 0;
        int maxlength= 0;
        int maxfreq = 0;
        for(int rigth = 0;rigth<s.length();rigth++){
            char c = s.charAt(rigth);
            
            freq[c - 'A']++;
            int winlen = rigth - left + 1;
            maxfreq = Math.max(freq[c-'A'],maxfreq);

            int chn = winlen - maxfreq;
            if(chn> k){ 
                char ch = s.charAt(left);
                freq[ch-'A']--;
                left++;
            }
            winlen = rigth - left + 1;
            maxlength = Math.max(maxlength,winlen);
        }
        return maxlength;
    }
}
