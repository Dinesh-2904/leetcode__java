class Solution {
    public int removeDuplicates(int[] nums){
        int left = 0;
        for(int rigth=0;rigth<nums.length;rigth++){
            if(left<2 || nums[rigth] != nums[left - 2]){
                nums[left] = nums[rigth];
                left++;
            }
        }
        return left;
    }
}
